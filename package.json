{
  "name": "kin-keepers-family-circle",
  "version": "0.1.0",
  "private": true,
  "description": "Kin-Keepers Family Circle Windows desktop application",
  "author": "Kin-Keepers",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "package:win": "npm run build && npx --yes electron-builder@26.15.3 --win nsis --x64",
    "verify:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "check": "npm run typecheck && npm run test && npm run verify:boundaries && npm run build"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "lucide-react": "1.39.0",
    "mammoth": "1.12.2",
    "nodemailer": "9.0.6",
    "pdf-parse": "2.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.0",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.kinkeepers.familycircle",
    "productName": "Family Circle",
    "files": [
      "dist/**/*",
      "config/offline-ai-manifest.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/family-circle.ico"
    },
    "nsis": {
      "artifactName": "Family-Circle-Setup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Family Circle",
      "deleteAppDataOnUninstall": false
    },
    "compression": "normal"
  }
}
